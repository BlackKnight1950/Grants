# Copy to .env for local use. Never commit .env.

# --- Smartsheet (the database) ---
# Personal API token: Smartsheet > Account > Personal Settings > API Access. Prefer a dedicated service account.
SMARTSHEET_ACCESS_TOKEN=
# The 19 sheet IDs are listed in sheets.json (committed to the repo). Nothing to set for them.
# Optional: a folder ID, only used by `npm run doctor` for its write test, or to auto-create a sheet that has no ID in sheets.json.
SMARTSHEET_FOLDER_ID=7432624944768900
# Optional: JSON that overrides sheets.json, e.g. {"grants":"123","tasks":"456",...}
SHEET_IDS=
# Optional. Default is https://api.smartsheet.com/2.0
# Gov: https://api.smartsheetgov.com/2.0   EU: https://api.smartsheet.eu/2.0   AU: https://api.smartsheet.au/2.0
SMARTSHEET_API_BASE=
# Optional. Seconds between checks for edits made directly in Smartsheet (default 20).
POLL_SECONDS=20

# --- Sign-in ---
# None yet. Sign-in is added later (see lib/auth.js). Until then anyone who can open the URL is an editor.

PORT=3000
